{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ImageRot UI",
    "version": "1.0.0",
    "identifier": "com.emy.imagerot-ui",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "",
        "frontendDist": "../../web/dist"
    },
    "app": {
        "windows": [
            {
                "title": "ImageRot UI",
                "width": 1280,
                "height": 720,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}