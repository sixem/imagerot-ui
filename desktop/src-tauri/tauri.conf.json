{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ImageRot UI",
    "mainBinaryName": "imagerot",
    "version": "1.0.0",
    "identifier": "com.emy.imagerot-ui",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "",
        "frontendDist": "../../web/dist"
    },
    "app": {
        "windows": [
            {
                "title": "ImageRot UI",
                "width": 1280,
                "height": 720,
                "dragDropEnabled": false,
                "backgroundColor": "#000",
                "label": "main"
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self' asset:",
                "img-src": "'self' asset: blob: data:",
                "style-src": "'self' 'unsafe-inline'",
                "worker-src": "'self' blob:",
                "connect-src": "'self' asset: blob: data: ipc:"
            },
            "capabilities": [
                {
                    "identifier": "save-file-capability",
                    "description": "Allows save dialog and writing to user-selected files",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:default",
                        "dialog:allow-save",
                        "fs:allow-write-file"
                    ]
                },
                {
                    "identifier": "open-external-safe",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        {
                            "identifier": "opener:allow-open-url",
                            "allow": [
                                {
                                    "url": "https://github.com/**"
                                },
                                {
                                    "url": "https://*.github.com/**"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis",
            "msi",
            "appimage",
            "deb",
            "rpm",
            "app",
            "dmg"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}